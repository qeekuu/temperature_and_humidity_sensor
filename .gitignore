# Cargo build output (any project in this repo)
target/

# Backup files generated by rustfmt
**/*.rs.bk

# Keys for e2e mode
keys/

# Counter state
state/

# TLS keys and certificates generated by certs/gen.sh
certs/*
!certs/gen.sh

# Broker passwords generated by mosquitto/gen-passwd.sh
mosquitto/config/passwd
mosquitto/credentials.env
